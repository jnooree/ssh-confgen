{
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 80,
	"tabWidth": 2,
	"plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"],
	"overrides": [
		{
			"files": "*.svelte",
			"options": {
				"parser": "svelte"
			}
		},
		{
			"files": ".vscode/*.json",
			"options": {
				"parser": "jsonc",
				"trailingComma": "all"
			}
		}
	],
	"tailwindStylesheet": "./src/routes/layout.css"
}
